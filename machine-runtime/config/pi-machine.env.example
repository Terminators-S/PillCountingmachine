# Copy this file to config/pi-machine.env on the Raspberry Pi and fill in the
# real backend URL / API key before daily use.

# Pi desktop preview environment. Keep these for the attached Pi display.
PILLCOUNT_DISPLAY=:0
PILLCOUNT_XDG_RUNTIME_DIR=/run/user/1000
PILLCOUNT_WAYLAND_DISPLAY=wayland-0

# Daily machine runtime behavior.
PILLCOUNT_DETECTOR_MODE=ml
PILLCOUNT_MODEL_PATH=../legacy/old-machine-runtime/machine-learning/models/local/train12/best_ncnn_model
PILLCOUNT_DEVICE=cpu
PILLCOUNT_MAX_FRAMES=0
PILLCOUNT_PREVIEW=1
PILLCOUNT_FULLSCREEN=1

# Backend sync to the PC-hosted support stack.
PILLCOUNT_SYNC_API_URL=http://YOUR_PC_IP:4000/api
PILLCOUNT_SYNC_API_KEY=replace-with-your-machine-api-key
PILLCOUNT_SYNC_TIMEOUT_SECONDS=10
PILLCOUNT_CONTROL_POLL_INTERVAL_SECONDS=2.0
PILLCOUNT_CONTROL_TIMEOUT_SECONDS=5.0

# Website live preview publishing. This feeds the existing /live dashboard page
# on the PC while keeping the Pi-attached display as the primary local preview.
PILLCOUNT_MACHINE_CODE=pill-counter-pi
PILLCOUNT_LIVE_PREVIEW_ENABLED=1
PILLCOUNT_LIVE_PREVIEW_INTERVAL_SECONDS=2.0
PILLCOUNT_LIVE_PREVIEW_TIMEOUT_SECONDS=15.0
PILLCOUNT_LIVE_PREVIEW_MAX_WIDTH=320
PILLCOUNT_LIVE_PREVIEW_JPEG_QUALITY=40

# Optional: start the machine runtime automatically as soon as the Pi agent
# service boots. This keeps website control available later through /live.
# Use the Pi agent service for this mode, not the separate always-on runtime
# service.
# PILLCOUNT_AUTOSTART_ON_BOOT=1

# Optional overrides.
# PILLCOUNT_CAMERA_INDEX=0
# PILLCOUNT_CAMERA_CONFIG=config/camera.default.json
# PILLCOUNT_COUNTING_CONFIG=config/counting.default.json
# PILLCOUNT_INPUT_VIDEO=
# PILLCOUNT_MODEL_KEY=local-train12
# PILLCOUNT_INFERENCE_SIZE=512   # Avoid overriding this for NCNN exports on the Pi.
# PILLCOUNT_SAVE_DEBUG_OVERLAY_FRAMES=0
# PILLCOUNT_SAVE_CROSSING_EVENT_FRAMES=0
# PILLCOUNT_MAX_DEBUG_FRAMES=0
# PILLCOUNT_WINDOWED=1
# PILLCOUNT_NO_SYNC=1

# Remote website control mode:
# - run `bash scripts/start_machine.sh` for direct local starts on the Pi
# - run `bash scripts/start_machine_agent.sh` or the systemd agent service when
#   you want the dashboard /live page to start and stop the Pi remotely
# - set `PILLCOUNT_AUTOSTART_ON_BOOT=1` when you want the Pi agent to launch
#   the ML runtime immediately after boot and still remain controllable later
