API_PROXY_TARGET=http://localhost:4000/api
# Public fallback if the browser should call the API directly.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
ML_PROJECT_PATH=H:\ONEDRIVE LINK\Pill_Counter_Machine
ML_PYTHON_EXECUTABLE=python
ML_BRIDGE_SCRIPT_PATH=H:\ONEDRIVE LINK\Pill_Counter_Machine\live_runtime_bridge.py
