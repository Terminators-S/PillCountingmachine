NODE_ENV=development
# Nest API port (defaults to 4000 if omitted).
API_PORT=4000
# For hosted API deploys, set this to an external Postgres connection string.
DATABASE_URL=postgresql://pillcount:pillcount@localhost:5432/pillcount?schema=public
JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
LOW_STOCK_THRESHOLD=20
EXPIRY_ALERT_DAYS=30
# Legacy bridge runtime only. The active Raspberry Pi MVP runtime now lives in /machine-runtime.
# Set these only if you still want the API-controlled bridge flow for legacy experiments.
ML_PROJECT_PATH=../../legacy/old-machine-runtime/machine-learning
ML_PYTHON_EXECUTABLE=python
# Optional overrides. Leave blank to use files inside ML_PROJECT_PATH.
ML_BRIDGE_SCRIPT_PATH=
ML_MODEL_CATALOG_PATH=
ROBOFLOW_API_KEY=
ROBOFLOW_INFERENCE_SERVER_URL=http://127.0.0.1:9001
ML_DEVICE_PROFILE=desktop
